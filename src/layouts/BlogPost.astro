---
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  draft?: boolean;
}

const { title, description, pubDate, updatedDate, tags = [], draft = false } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      {draft && <p class="draft-banner">DRAFT — not yet published</p>}
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)}</time>
        {updatedDate && (
          <> · updated <time datetime={updatedDate.toISOString()}>{dateFmt.format(updatedDate)}</time></>
        )}
        {tags.length > 0 && (
          <> · {tags.map((t) => <span class="tag">{t}</span>)}</>
        )}
      </p>
    </header>
    <slot />
  </article>
  <Giscus />
</BaseLayout>

<style>
  .post-header { margin-bottom: 2rem; }
  .post-header h1 { margin: 0.5rem 0; }
  .meta {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .tag {
    display: inline-block;
    padding: 0.1em 0.5em;
    margin-right: 0.25em;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8em;
  }
  .draft-banner {
    display: inline-block;
    padding: 0.25em 0.6em;
    background: #fff4ce;
    color: #5c3c00;
    border-radius: 4px;
    font-size: 0.8em;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  @media (prefers-color-scheme: dark) {
    .draft-banner {
      background: #3d2e00;
      color: #fadc6a;
    }
  }
</style>
