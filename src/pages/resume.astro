---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const capabilities = [
  {
    label: 'Native Mobile Engineering',
    details:
      'Swift, Kotlin, Objective-C, Java, C++, connected devices, offline workflows, and mobile-to-cloud architecture.',
  },
  {
    label: 'React and React Native',
    details:
      'Cross-platform products, TypeScript, React, GraphQL, design systems, performance, and frontend delivery at team scale.',
  },
  {
    label: 'Frontend and Product Systems',
    details:
      'Accessible product interfaces, API integration, distributed workflows, and architecture shaped by operational constraints.',
  },
  {
    label: 'Engineering Leadership',
    details:
      'Principal-level technical direction, team formation, hiring, standards, mentoring, and cross-functional execution.',
  },
  {
    label: 'Connected and Distributed Systems',
    details:
      'IoT, smart access, data pipelines, serverless platforms, event-driven systems, AWS, GCP, and backend services.',
  },
  {
    label: 'Security and Systems Rigor',
    details:
      'Threat modeling, application security, red-team methodology, secure code review, trust boundaries, and resilient delivery.',
  },
];

const roles = [
  {
    org: 'Brivo',
    title: 'Lead Software Engineer',
    meta: 'December 2023 - Present / Remote',
    bullets: [
      'Leads design and delivery for distributed smart-access and IoT platforms with security-first architecture as a core constraint.',
      'Drives threat modeling, secure code review, CI/CD hardening, and cross-team alignment between engineering, product, and security.',
      'Translates platform risk into practical engineering decisions for systems that connect cloud services, devices, and user workflows.',
    ],
  },
  {
    org: 'Riffle Analytics',
    title: 'Lead AI and Mobile Engineer',
    meta: 'February 2019 - December 2023 / Portland, Maine area',
    bullets: [
      'Built privacy-aware native mobile applications in Swift, Kotlin, and C++ for data-sensitive workflows.',
      'Designed Python and Node.js data pipelines feeding ML systems while keeping user data protection and operational boundaries visible.',
      'Created internal tooling and review practices to improve mobile security posture and application resilience.',
    ],
  },
  {
    org: 'VividCloud',
    title: 'Principal Software Engineer 2',
    meta: 'August 2020 - November 2023 / Brunswick, Maine',
    bullets: [
      'Led multi-disciplinary teams across Python, .NET, Java, and Swift projects with an emphasis on secure, scalable architecture.',
      'Ran internal red-team assessments and security reviews for client systems, turning findings into engineering priorities.',
      'Advised on mobile application security, distributed system design, and cloud infrastructure practices with DevSecOps partners.',
    ],
  },
  {
    org: 'GrowFlow Corp',
    title: 'Mobile Engineering Lead and Manager',
    meta: 'May 2019 - August 2020 / Remote',
    bullets: [
      'Managed and grew a cross-platform mobile engineering team building React Native and TypeScript products.',
      'Designed backend services and GraphQL APIs around role-based access, data integrity, and resilience.',
      'Introduced secure development lifecycle practices and peer security reviews into normal delivery routines.',
    ],
  },
  {
    org: 'Minnow',
    title: 'Director of Engineering, Mobile',
    meta: 'January 2018 - December 2019 / Portland, Maine area',
    bullets: [
      'Owned Swift and Kotlin mobile architecture for distributed, sensor-driven systems connected to IoT and backend platforms.',
      'Coordinated mobile, hardware, and backend work across Go, Elixir, and Python services with security and quality standards in view.',
      'Managed contractor teams and established practices for testing, threat mitigation, and maintainable delivery.',
    ],
  },
  {
    org: 'Vox Media',
    title: 'Application Security Engineer',
    meta: 'June 2017 - August 2018 / Portland, Maine area',
    bullets: [
      'Led internal red-team operations covering application-layer penetration testing, vulnerability research, and proof-of-concept exploits.',
      'Partnered with development teams on secure code review, threat modeling, infrastructure hardening, and SecDevOps pipelines.',
      'Built security-conscious product features and data pipelines across TypeScript, React, Swift, ARKit, Python, and GCP Dataflow.',
    ],
  },
  {
    org: 'Vets First Choice',
    title: 'Director of Engineering - Mobile and Web Front End',
    meta: 'March 2014 - June 2017 / Portland, Maine area',
    bullets: [
      'Built and led multiple engineering teams delivering native iOS, Android, web, GraphQL, and data pipeline systems.',
      'Designed AWS platform foundations and backend services using TypeScript, Node.js, Python, and GraphQL.',
      'Balanced hands-on engineering with team leadership, hiring, standards, and technical direction for mobile and web products.',
    ],
  },
];

const earlySystems = [
  '1999 - 2002: Built early web, reporting, financial-market, and EDI systems with PHP, Python, Perl, MySQL, ASP, VB6, and ASP.NET.',
  '2003 - 2011: Delivered line-of-business platforms across Rails, Django, PHP, C#, SQL Server, Oracle, and ASP.NET MVC.',
  '2011 - 2014: Moved deeper into mobile, microservices, and API systems with Objective-C, Java Android, Python, Go, Node.js, and JavaScript.',
];

const signals = [
  {
    label: 'Lab Writeup',
    title: 'Breaking Agents to Build Better Ones: LLM01 Prompt Injection',
    href: `${base}/blog/breaking-agents-llm01-prompt-injection`,
    details:
      'A local RAG prompt-injection lab for testing agent trust boundaries, attack success, and defensive spotlighting.',
  },
  {
    label: 'Field Notes',
    title: 'What I Learned Building Production Agents',
    href: `${base}/blog/production-agent-attack-surface`,
    details:
      'A practical map of input, tool, memory, and orchestration risks in production agent workflows.',
  },
  {
    label: 'Supply Chain',
    title: 'Supply Chain Attacks on AI Tooling',
    href: `${base}/blog/shai-hulud-ai-tooling`,
    details:
      'Notes on AI developer environment risk, package compromise response, offline scanners, and provenance gaps.',
  },
  {
    label: 'LinkedIn Publication',
    title: "Testing and Packaging JavaScript: Js's final frontier",
    href: 'https://www.linkedin.com/in/shawnmcampbell/details/publications/',
    details:
      'A published presentation on front-end testing and packaging practices that prefigures later delivery and security automation work.',
  },
  {
    label: 'LinkedIn Publication',
    title: "Servers: We don't need any stinkin' servers",
    href: 'https://www.linkedin.com/in/shawnmcampbell/details/publications/',
    details:
      'Serverless architecture material from the public profile, relevant to cloud-native system design and operational tradeoffs.',
  },
];
---

<BaseLayout
  title="Resume — Shawn Campbell"
  description="Shawn Campbell: mobile and product engineer, frontend architect, React Native leader, and hands-on engineering leader."
>
  <article class="resume-dossier">
    <section class="hero-panel">
      <div>
        <p class="kicker ops-only">Crew File / Mission Profile</p>
        <p class="kicker direct-only">Professional Profile</p>
        <h1>Shawn Campbell</h1>
        <p class="role-line">
          Mobile and Product Engineer, frontend architect, and hands-on
          engineering leader.
        </p>
        <p class="mission-copy">
          Shawn Campbell has spent 25 years building software, products, and
          engineering teams. His strongest depth is in native mobile, React and
          React Native, connected products, frontend systems, and technical
          leadership. Security remains part of the engineering discipline, while
          game development in Godot and Unreal is a current learning focus.
        </p>
        <ul class="badge-row" aria-label="Mission badges">
          <li>Native Mobile</li>
          <li>React Native</li>
          <li>Frontend Systems</li>
          <li>Engineering Leadership</li>
          <li>Connected Products</li>
        </ul>
      </div>

      <aside class="contact-panel" aria-label="Profile telemetry">
        <p class="panel-label ops-only">Telemetry</p>
        <p class="panel-label direct-only">Summary</p>
        <dl>
          <div>
            <dt>Operating Mode</dt>
            <dd>Principal IC / technical lead / engineering leader</dd>
          </div>
          <div>
            <dt>Primary Focus</dt>
            <dd>Native mobile, React Native, frontend, connected products</dd>
          </div>
          <div>
            <dt>Current learning focus</dt>
            <dd>Game Development with Godot and Unreal Engine</dd>
          </div>
        </dl>
      </aside>
    </section>

    <section class="dossier-section" aria-labelledby="capabilities-heading">
      <p class="kicker ops-only">Capabilities Matrix</p>
      <p class="kicker direct-only">Core Capabilities</p>
      <h2 id="capabilities-heading">Mobile, Product, and Engineering Leadership</h2>
      <div class="capability-grid">
        {capabilities.map((capability) => (
          <article class="capability-card">
            <h3>{capability.label}</h3>
            <p>{capability.details}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="dossier-section" aria-labelledby="record-heading">
      <p class="kicker ops-only">Operational Record</p>
      <p class="kicker direct-only">Experience</p>
      <h2 id="record-heading">
        <span class="ops-only">Recent Assignments</span>
        <span class="direct-only">Professional Experience</span>
      </h2>
      <div class="timeline">
        {roles.map((role) => (
          <article class="role-card">
            <div class="role-header">
              <div>
                <h3>{role.org}</h3>
                <p>{role.title}</p>
              </div>
              <span>{role.meta}</span>
            </div>
            <ul>
              {role.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="dossier-section" aria-labelledby="early-heading">
      <p class="kicker ops-only">Early Systems Work</p>
      <p class="kicker direct-only">Earlier Experience</p>
      <h2 id="early-heading">Foundation Layer</h2>
      <ol class="early-list">
        {earlySystems.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section class="dossier-section" aria-labelledby="signals-heading">
      <p class="kicker ops-only">Selected Signals</p>
      <p class="kicker direct-only">Selected Writing</p>
      <h2 id="signals-heading">Writing, Research, and Public Artifacts</h2>
      <div class="signals-grid">
        {signals.map((signal) => (
          <a class="signal-card" href={signal.href}>
            <span>{signal.label}</span>
            <strong>{signal.title}</strong>
            <p>{signal.details}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="dossier-section contact-panel" aria-labelledby="links-heading">
      <p class="kicker ops-only">Professional Channels</p>
      <p class="kicker direct-only">Links</p>
      <h2 id="links-heading">Public Channels</h2>
      <nav class="contact-links" aria-label="Professional links">
        <a href="https://www.linkedin.com/in/shawnmcampbell">LinkedIn</a>
        <a href="https://github.com/jaegerpicker">GitHub</a>
        <a href={`${base}/blog`}>Blog</a>
      </nav>
    </section>
  </article>
</BaseLayout>

<style>
  .resume-dossier {
    position: relative;
    display: grid;
    gap: 1.2rem;
    padding: 2rem 0 3rem;
  }

  .hero-panel,
  .dossier-section,
  .contact-panel,
  .capability-card,
  .role-card,
  .signal-card {
    position: relative;
    border: 1px solid var(--border);
    background:
      linear-gradient(135deg, rgba(94, 218, 231, 0.08), transparent 16rem),
      var(--bg-panel);
    box-shadow: var(--panel-shadow);
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.36fr);
    gap: 1rem;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-panel::after {
    content: "";
    position: absolute;
    right: -8rem;
    top: -9rem;
    width: 24rem;
    aspect-ratio: 1;
    border: 1px solid rgba(228, 173, 84, 0.28);
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 4rem rgba(94, 218, 231, 0.02),
      0 0 0 3.5rem rgba(94, 218, 231, 0.03);
    pointer-events: none;
  }

  .kicker,
  .panel-label {
    margin: 0 0 0.6rem;
    color: var(--warning);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0.6rem;
    color: var(--fg);
    font-size: clamp(2.5rem, 8vw, 5.6rem);
    line-height: 0.92;
  }

  h2 {
    margin-bottom: 1rem;
    color: var(--fg);
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  h3 {
    margin-bottom: 0.45rem;
    color: var(--fg);
    font-size: 1rem;
  }

  .role-line {
    max-width: 48rem;
    color: var(--accent-strong);
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.45;
  }

  .mission-copy {
    max-width: 58rem;
    color: var(--fg-muted);
    line-height: 1.75;
  }

  .badge-row,
  .role-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .badge-row li,
  .contact-links a {
    border: 1px solid rgba(228, 173, 84, 0.4);
    background: rgba(228, 173, 84, 0.08);
    color: var(--warning-strong);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .badge-row li {
    padding: 0.45rem 0.6rem;
  }

  .contact-panel {
    background-color: var(--bg-panel-strong);
    padding: 1rem;
  }

  .contact-panel dl {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }

  .contact-panel dt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .contact-panel dd {
    margin: 0.2rem 0 0;
    color: var(--fg);
    line-height: 1.45;
  }

  .dossier-section {
    padding: clamp(1rem, 2.5vw, 1.45rem);
  }

  .capability-grid,
  .signals-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .capability-card,
  .signal-card {
    min-height: 100%;
    padding: 1rem;
  }

  .capability-card p,
  .signal-card p,
  .role-card li,
  .early-list li {
    color: var(--fg-muted);
    line-height: 1.62;
  }

  .timeline {
    display: grid;
    gap: 0.75rem;
  }

  .role-card {
    padding: 1rem;
  }

  .role-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.34fr);
    gap: 1rem;
    border-bottom: 1px solid rgba(94, 218, 231, 0.18);
    margin-bottom: 0.8rem;
    padding-bottom: 0.75rem;
  }

  .role-header p,
  .role-header span {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .role-header span {
    color: var(--fg-muted);
    text-align: right;
  }

  .role-card li {
    position: relative;
    padding-left: 1rem;
  }

  .role-card li + li {
    margin-top: 0.45rem;
  }

  .role-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.38rem;
    height: 1px;
    background: var(--warning);
  }

  .early-list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  .early-list li::marker {
    color: var(--warning);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .signal-card {
    display: grid;
    gap: 0.45rem;
    color: inherit;
    text-decoration: none;
  }

  .signal-card:hover,
  .signal-card:focus-visible,
  .contact-links a:hover,
  .contact-links a:focus-visible {
    border-color: var(--border-strong);
    outline: none;
    box-shadow: 0 0 0 3px rgba(94, 218, 231, 0.13);
  }

  .signal-card span {
    color: var(--warning);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .signal-card strong {
    color: var(--fg);
    line-height: 1.35;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.65rem 0.85rem;
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .hero-panel,
    .role-header {
      grid-template-columns: 1fr;
    }

    .hero-panel::after {
      opacity: 0.45;
    }

    .role-header span {
      text-align: left;
    }
  }

  @media (max-width: 860px) {
    .capability-grid,
    .signals-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(html[data-view='direct']) .resume-dossier {
    gap: 1rem;
    max-width: 960px;
    margin: 0 auto;
  }

  :global(html[data-view='direct']) .hero-panel,
  :global(html[data-view='direct']) .dossier-section,
  :global(html[data-view='direct']) .contact-panel,
  :global(html[data-view='direct']) .capability-card,
  :global(html[data-view='direct']) .role-card,
  :global(html[data-view='direct']) .signal-card {
    background: #fff;
    box-shadow: none;
  }

  :global(html[data-view='direct']) .hero-panel::after {
    display: none;
  }

  :global(html[data-view='direct']) .hero-panel {
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.32fr);
  }

  :global(html[data-view='direct']) h1 {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
  }

  :global(html[data-view='direct']) .role-line {
    color: var(--fg);
    font-weight: 700;
  }

  @media (max-width: 1100px) {
    :global(html[data-view='direct']) .hero-panel {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    :global(header),
    :global(footer),
    .signals-grid,
    .contact-links {
      display: none !important;
    }

    :global(html),
    :global(body) {
      background: #fff !important;
      color: #111 !important;
    }

    :global(main) {
      width: 100%;
      padding: 0;
    }

    .resume-dossier {
      display: block;
      padding: 0;
    }

    .hero-panel,
    .dossier-section,
    .contact-panel,
    .capability-card,
    .role-card {
      break-inside: avoid;
      border-color: #bbb;
      background: #fff !important;
      box-shadow: none;
    }

    .hero-panel {
      grid-template-columns: 1fr;
    }

    .hero-panel::after,
    .ops-only {
      display: none !important;
    }

    .direct-only {
      display: revert !important;
    }

    h1,
    h2,
    h3,
    .role-line,
    .contact-panel dt,
    .contact-panel dd {
      color: #111 !important;
    }

    p,
    li,
    .role-header span {
      color: #333 !important;
    }
  }
</style>
