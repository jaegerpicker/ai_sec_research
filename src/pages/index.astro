---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="ai-sec-research">
  <section class="intro">
    <h1>ai-sec-research</h1>
    <p>
      Notes on AI security, red teaming, and the attack surface of agentic systems.
      Maintained by Shawn Campbell. Mostly written to think out loud about what I'm
      breaking and building.
    </p>
    <p>
      <a href={`${base}/blog`}>Read the blog →</a>
    </p>
  </section>

  {posts.length > 0 && (
    <section>
      <h2>Latest</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`${base}/blog/${post.id}`}>{post.data.title}</a>
            <p class="muted">{post.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .intro { margin-bottom: 2rem; }
  .post-list { list-style: none; padding: 0; }
  .post-list li { margin-bottom: 1.25rem; }
  .post-list p { margin: 0.25rem 0 0; font-size: 0.95em; }
</style>
